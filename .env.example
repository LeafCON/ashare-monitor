# 复制为 .env 后填写。不要把真实 token 发到聊天里。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 只有 Forum 话题群才需要；普通聊天留空
TELEGRAM_THREAD_ID=

# true：后台告警只打印，不请求 Telegram
# 看板上的「真发 Telegram」按钮不受这一项影响
ALERT_DRY_RUN=true

# 自动下单开关。某个市场的接口没配好时，那一路只等待，不发单。
TRADING_AUTO_ORDER=false

# 交易决策，四个市场共用。没填对应接口时，那一路等待，不发单。
# 加密货币：
BINANCE_API_KEY=
BINANCE_API_SECRET=
AGENT_SYMBOLS=BTCUSDT,ETHUSDT
# A股、港股、美股。三个都要填，STOCK_BROKER_MARKETS 里写要启用的市场。
STOCK_BROKER_API_BASE=
STOCK_BROKER_API_KEY=
STOCK_BROKER_API_SECRET=
STOCK_BROKER_MARKETS=cn,hk,us
STOCK_BROKER_QUOTE_BALANCE=0
JEV_API_KEY=
AGENT_KILL=false
AGENT_HF=false
HF_REFLEX_MODEL=
REFLEX_MODE=local
# local：用这台电脑上已经运行的模型服务。api：用下面的地址和密钥，没填则等待。
LLAMA_SERVER_URL=http://127.0.0.1:8091
REFLEX_API_URL=
REFLEX_API_KEY=
